{
	"name": "woocommerce-fraud-protection",
	"version": "0.1.8",
	"description": "A plugin to protect WooCommerce from fraud.",
	"author": "Automattic",
	"license": "GPL-3.0-or-later",
	"files": [
		"assets",
		"src",
		"vendor",
		"changelog.txt",
		"woocommerce-fraud-protection-loader.php",
		"woocommerce-fraud-protection.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"build:qit": "npm run build:release && bin/package-qit-zip.sh woocommerce-fraud-protection.zip woocommerce-fraud-protection-qit.zip",
		"build:release": "composer install --prefer-dist --no-dev --no-interaction --no-progress && wp-scripts build --mode=production && wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean",
		"env:destroy": "wp-env destroy",
		"env:update": "wp-env start --update",
		"env:setup": "bash ./bin/wp-env-setup.sh",
		"postenv:start": "bash ./bin/wp-env-setup.sh",
		"postenv:update": "bash ./bin/wp-env-setup.sh",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"lint:js": "wp-scripts lint-js assets/js",
		"lint:css": "wp-scripts lint-style assets/css --allow-empty-input",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:autofix": "vendor/bin/phpcbf",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"test": "npm run test:smoke && npm run test:php && npm run test:js",
		"test:js": "wp-scripts test-unit-js",
		"test:php": "vendor/bin/phpunit",
		"test:php:env": "vendor/bin/phpunit",
		"test:smoke": "tests/php/smoke/run.sh",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
		"phpstan:baseline": "vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon"
	},
	"devDependencies": {
		"@babel/runtime": "^7.24.0",
		"@wordpress/env": "10.39.0",
		"@wordpress/scripts": "^31.7.0",
		"jquery": "^3.7.1"
	},
	"engines": {
		"node": "^20.11.1"
	},
	"jest": {
		"testMatch": [
			"**/tests/js/**/*.test.js"
		],
		"setupFilesAfterEnv": [
			"./tests/js/setup.js"
		]
	}
}
