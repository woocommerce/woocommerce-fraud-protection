{
	"name": "woocommerce-fraud-protection",
	"version": "0.2.1",
	"description": "A plugin to protect WooCommerce from fraud.",
	"author": "Automattic",
	"license": "GPL-3.0-or-later",
	"files": [
		"assets",
		"build",
		"src",
		"vendor",
		"changelog.txt",
		"woocommerce-fraud-protection-loader.php",
		"woocommerce-fraud-protection.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"build:qit": "npm run build:release && bin/package-qit-zip.sh woocommerce-fraud-protection.zip woocommerce-fraud-protection-qit.zip",
		"build:release": "wp-scripts build --mode=production && wp-scripts plugin-zip && zip -d woocommerce-fraud-protection.zip woocommerce-fraud-protection/package.json woocommerce-fraud-protection/README.md",
		"start": "wp-scripts start",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean",
		"env:destroy": "wp-env destroy",
		"env:update": "wp-env start --update",
		"env:setup": "bash ./bin/wp-env-setup.sh",
		"postenv:start": "bash ./bin/wp-env-setup.sh",
		"postenv:update": "bash ./bin/wp-env-setup.sh",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:types && npm run lint:php",
		"lint:js": "wp-scripts lint-js assets/js client tests/js/admin-settings.test.tsx",
		"lint:css": "wp-scripts lint-style assets/css client/admin-settings/style.scss --allow-empty-input",
		"lint:types": "tsc --noEmit",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:autofix": "vendor/bin/phpcbf",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"test": "npm run test:smoke && npm run test:php && npm run test:js",
		"test:js": "wp-scripts test-unit-js",
		"test:php": "vendor/bin/phpunit",
		"test:php:env": "vendor/bin/phpunit",
		"test:smoke": "tests/php/smoke/run.sh",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
		"phpstan:baseline": "vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon"
	},
	"devDependencies": {
		"@babel/runtime": "^7.24.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.43",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/element": "^8.6.0",
		"@wordpress/env": "10.39.0",
		"@wordpress/i18n": "^6.27.0",
		"@wordpress/icons": "^15.5.0",
		"@wordpress/scripts": "^31.7.0",
		"jquery": "^3.7.1",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": "^20.11.1"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"moduleNameMapper": {
			"\\.(css|scss)$": "<rootDir>/tests/js/style-mock.js"
		},
		"testMatch": [
			"**/tests/js/**/*.test.js",
			"**/tests/js/**/*.test.ts",
			"**/tests/js/**/*.test.tsx"
		],
		"setupFilesAfterEnv": [
			"./tests/js/setup.js"
		]
	}
}
